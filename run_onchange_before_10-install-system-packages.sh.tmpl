#!/usr/bin/env bash
set -euo pipefail

# Re-trigger when either package list changes. Sprig sha256sum on the file
# contents makes chezmoi see a content change and re-run the script.
# arch.txt sha256: {{ include (joinPath .chezmoi.sourceDir "packages/arch.txt") | sha256sum }}
# aur.txt sha256:  {{ include (joinPath .chezmoi.sourceDir "packages/aur.txt") | sha256sum }}

PKG_DIR="{{ .chezmoi.sourceDir }}/packages"

if [[ -f "$PKG_DIR/arch.txt" ]]; then
  mapfile -t pkgs < <(grep -v '^#\|^$' "$PKG_DIR/arch.txt")
  if (( ${#pkgs[@]} > 0 )); then
    sudo pacman -S --needed --noconfirm "${pkgs[@]}"
  fi
fi

if [[ -f "$PKG_DIR/aur.txt" ]] && command -v yay >/dev/null 2>&1; then
  mapfile -t pkgs < <(grep -v '^#\|^$' "$PKG_DIR/aur.txt")
  if (( ${#pkgs[@]} > 0 )); then
    yay -S --needed --noconfirm "${pkgs[@]}"
  fi
fi
