#!/usr/bin/env python3
"""Cast a Hyprland output to a Google Cast device (screen + desktop audio).

mkchromecast's --screencast is unusable here: it hardcodes ffmpeg's x11grab,
which reads the XWayland root window.  Hyprland never composites the desktop
into that window, so the capture is solid black.  Its --command escape hatch
does not help either -- it only accepts the literal strings "ffmpeg" or
"yt-dlp".

So capture the real output with gpu-screen-recorder (DRM/KMS, hardware H.264),
mux it into fragmented mp4, serve it over HTTP and point the cast device at it.

Two details matter, both learned the hard way:

  * AAC copied out of MPEG-TS carries ADTS framing, which is invalid inside
    mp4.  Without `-bsf:a aac_adtstoasc` the receiver buffers forever and never
    reaches PLAYING.
  * Audio is captured by gpu-screen-recorder rather than as a second ffmpeg
    input, so both tracks share one timebase and start at 0.

Latency is roughly 5-10s: the Default Media Receiver buffers aggressively over
progressive HTTP.  For low-latency mirroring use Chromium's Cast -> "Cast
screen" instead, which uses the WebRTC-based mirroring receiver.

The listening port must be open in ufw, e.g.
    sudo ufw allow from 172.17.34.0/24 to any port 8080 proto tcp
"""

import argparse
import shutil
import socket
import subprocess
import sys
import threading
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

import pychromecast

STREAM_PATH = "/stream"


def default_audio_source() -> str:
    sink = subprocess.run(
        ["pactl", "get-default-sink"], capture_output=True, text=True, check=True
    ).stdout.strip()
    return f"{sink}.monitor"


def local_ip(peer: str) -> str:
    sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    try:
        sock.connect((peer, 8009))
        return sock.getsockname()[0]
    finally:
        sock.close()


def capture_pipeline(opts, audio_source):
    """gpu-screen-recorder (h264+aac/mpegts) -> ffmpeg (fragmented mp4 on stdout)."""
    grab_cmd = [
        "gpu-screen-recorder",
        "-w", opts.monitor,
        "-s", opts.size,
        "-f", str(opts.fps),
        "-k", "h264",
        "-keyint", "1",          # 1s keyframes: faster start, smaller fragments
        "-c", "mpegts",
        "-o", "/dev/stdout",
    ]
    if audio_source:
        grab_cmd += ["-ac", "aac", "-a", f"device:{audio_source}"]

    grab = subprocess.Popen(grab_cmd, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)

    mux_cmd = [
        "ffmpeg", "-hide_banner", "-loglevel", "error",
        "-f", "mpegts", "-i", "pipe:0",
        "-c", "copy",
    ]
    if audio_source:
        # ADTS -> ASC; without this the mp4 audio track is malformed and the
        # receiver never leaves BUFFERING.
        mux_cmd += ["-bsf:a", "aac_adtstoasc"]
    mux_cmd += [
        "-f", "mp4",
        "-movflags", "frag_keyframe+empty_moov+default_base_moof",
        "-frag_duration", "500000",
        "pipe:1",
    ]
    mux = subprocess.Popen(
        mux_cmd, stdin=grab.stdout, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL
    )
    grab.stdout.close()  # so grab sees SIGPIPE when mux exits
    return grab, mux


class StreamHandler(BaseHTTPRequestHandler):
    opts = None
    audio_source = None

    def log_message(self, fmt, *args):
        print(f"  http: {self.address_string()} {fmt % args}", flush=True)

    def do_GET(self):
        if self.path.split("?")[0] != STREAM_PATH:
            self.send_error(404)
            return

        grab, mux = capture_pipeline(self.opts, self.audio_source)
        self.send_response(200)
        self.send_header("Content-Type", "video/mp4")
        self.send_header("Cache-Control", "no-cache")
        self.end_headers()
        try:
            while True:
                chunk = mux.stdout.read(65536)
                if not chunk:
                    break
                self.wfile.write(chunk)
        except (BrokenPipeError, ConnectionResetError):
            print("  viewer disconnected", flush=True)
        finally:
            for proc in (mux, grab):
                if proc.poll() is None:
                    proc.terminate()
            for proc in (mux, grab):
                try:
                    proc.wait(timeout=5)
                except subprocess.TimeoutExpired:
                    proc.kill()


def find_device(name, tries=3):
    for attempt in range(tries):
        casts, browser = pychromecast.get_listed_chromecasts(
            friendly_names=[name], timeout=20
        )
        if casts:
            return casts[0], browser
        browser.stop_discovery()
        print(f"  not found (attempt {attempt + 1}/{tries}), retrying", flush=True)
    return None, None


def main():
    parser = argparse.ArgumentParser(
        description="Cast a Hyprland output to a Google Cast device.")
    parser.add_argument("-n", "--name", required=True, help="cast device friendly name")
    parser.add_argument("-m", "--monitor", default="eDP-1",
                        help="Hyprland output name, or 'portal' (default: eDP-1)")
    parser.add_argument("-p", "--port", type=int, default=8080,
                        help="local HTTP port, must be open in ufw (default: 8080)")
    parser.add_argument("-s", "--size", default="1920x1080", help="streamed resolution")
    parser.add_argument("-f", "--fps", type=int, default=30)
    parser.add_argument("-a", "--audio", default=None,
                        help="pulse source name (default: monitor of default sink)")
    parser.add_argument("--no-audio", action="store_true", help="stream video only")
    parser.add_argument("--list-monitors", action="store_true",
                        help="list capturable outputs and exit")
    opts = parser.parse_args()

    for tool in ("gpu-screen-recorder", "ffmpeg", "pactl"):
        if not shutil.which(tool):
            print(f"error: {tool} not found in PATH", file=sys.stderr)
            return 1

    if opts.list_monitors:
        subprocess.run(["gpu-screen-recorder", "--list-capture-options"])
        return 0

    audio_source = None if opts.no_audio else (opts.audio or default_audio_source())
    print(f"audio: {audio_source or 'disabled'}")

    print(f"looking for {opts.name!r} ...", flush=True)
    cast, browser = find_device(opts.name)
    if cast is None:
        print(f"error: cast device {opts.name!r} not found", file=sys.stderr)
        return 1
    cast.wait(timeout=20)
    print(f"found {opts.name!r} at {cast.cast_info.host}")

    url = f"http://{local_ip(cast.cast_info.host)}:{opts.port}{STREAM_PATH}"
    StreamHandler.opts = opts
    StreamHandler.audio_source = audio_source
    server = ThreadingHTTPServer(("0.0.0.0", opts.port), StreamHandler)
    threading.Thread(target=server.serve_forever, daemon=True).start()
    print(f"serving {url}")

    # A stale session on the receiver makes play_media fail, so clear it first.
    if cast.status and cast.status.app_id:
        cast.quit_app()
        time.sleep(3)
    if cast.status and cast.status.volume_muted:
        cast.set_volume_muted(False)

    print("casting (ctrl-c to stop) ...", flush=True)
    cast.media_controller.play_media(
        url, "video/mp4", title="Hyprland desktop", stream_type="LIVE"
    )
    cast.media_controller.block_until_active(timeout=30)

    try:
        while True:
            status = cast.media_controller.status
            print(f"  state={status.player_state}", flush=True)
            time.sleep(5)
    except KeyboardInterrupt:
        print("\nstopping")
    finally:
        try:
            cast.quit_app()
        except Exception:
            pass
        server.shutdown()
        if browser:
            browser.stop_discovery()
    return 0


if __name__ == "__main__":
    sys.exit(main())
