#!/usr/bin/env bash
set -uo pipefail
VAULT="$HOME/vaults"
cd "$VAULT" 2>/dev/null || exit 0
git rev-parse --is-inside-work-tree >/dev/null 2>&1 || exit 0

git add -A
if ! git diff --cached --quiet; then
  git commit -q -m "vault backup: $(date '+%Y-%m-%d %H:%M:%S')"
fi

# Push if there are unpushed commits (also recovers from an earlier offline run)
if [ -z "$(git rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null)" ] \
  || [ -n "$(git log '@{u}..' --oneline 2>/dev/null)" ]; then
  git push -q origin main || echo "vault-backup: push failed (will retry next run)"
fi
